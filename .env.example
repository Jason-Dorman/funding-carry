# Basis Carry System — public configuration template
#
# Copy to .env (`make env`) for local runs. Every value here is a SYNTHETIC
# PLACEHOLDER: fitted thresholds, weights, credentials and session keys live only
# in .env.private, which is gitignored (spec section 9).
#
# Variable catalogue and scopes: docs/api-spec.md section 7.
# Venue numbers (contract size, funding, margin, fees): docs/venue-coinbase-perps.md

# ---------------------------------------------------------------------------
# Infrastructure (deploy scope — consumed by docker-compose, not by the binaries)
# ---------------------------------------------------------------------------
POSTGRES_USER=carry
POSTGRES_PASSWORD=carry
POSTGRES_DB=carry

# ---------------------------------------------------------------------------
# All binaries
# ---------------------------------------------------------------------------
# Inside Compose the host is the service name; running a binary on the host
# instead, use localhost.
DATABASE_URL=postgres://carry:carry@timescaledb:5432/carry?sslmode=disable
ASSET=ETH
PERP_PRODUCT_ID=ETP-20DEC30-CDE
SPOT_PRODUCT_ID=ETH-USD

# One metrics address per binary so all three can also run side by side on a host.
INGEST_METRICS_ADDR=:9101
CARRY_METRICS_ADDR=:9102
SIM_METRICS_ADDR=:9103

LOG_LEVEL=info
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Venue endpoints (ingest, carry)
# ---------------------------------------------------------------------------
CB_API_URL=https://api.coinbase.com/api/v3/brokerage/
CB_WS_URL=wss://advanced-trade-ws.coinbase.com
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/replace-me
ALCHEMY_API_KEY=

# ---------------------------------------------------------------------------
# Ingest polling
# ---------------------------------------------------------------------------
POLL_REST_SECS=5
POLL_BASE_SECS=30
BOOK_SNAP_SECS=10

# ---------------------------------------------------------------------------
# Contract (carry, research) — see docs/venue-coinbase-perps.md
# ---------------------------------------------------------------------------
CONTRACT_SIZE_ETH=0.10

# ---------------------------------------------------------------------------
# Decision thresholds (carry) — SYNTHETIC. Real values in .env.private.
# ---------------------------------------------------------------------------
Z_ENTER=1.5
Z_EXIT=0.5
F_FLIP=0
K_COST_MULT=2
# Hours the ENTER rule assumes a carry is held. Costs are a one-time round-trip
# toll while funding accrues hourly, so this — not the notional cap — decides
# whether ENTER can ever be satisfiable (build plan, research task R1).
CARRY_HORIZON_HOURS=168
BASIS_EXTREME=0.007
SPREAD_MAX_BPS=5
# w1 funding z-score, w2 cumulative funding, w3 basis
PRESSURE_WEIGHTS=0.5,0.3,0.2

# ---------------------------------------------------------------------------
# Risk limits (carry) — SYNTHETIC. Real values in .env.private.
# ---------------------------------------------------------------------------
# Must stay at or under half a contract: the perp leg only moves in whole
# contracts, so the spot leg can always close more than this.
DELTA_TOLERANCE_ETH=0.05
MAX_NOTIONAL_USD=500
# Hard ceiling: 3x overnight margin. carry refuses to start above it.
MAX_LEVERAGE=3
MARGIN_RATIO_FLOOR=1.5
# Must stay false in v1: carry refuses to start if it is true.
INTRADAY_MARGIN_OPT_IN=false
DAILY_LOSS_LIMIT_USD=25
FUNDING_RECON_TOLERANCE_USD=0.50
STALE_FEED_SECS=60
KILL_SWITCH=false

# Venue trading break: no orders, and the funding series records a gap for that
# hour rather than a zero.
MAINTENANCE_BREAK=Fri 17:00-18:00 America/New_York

# ---------------------------------------------------------------------------
# Treasury transition timeouts (carry) — spec section 6.8
# ---------------------------------------------------------------------------
TREASURY_TRANSFER_TIMEOUT=5m
TREASURY_SWEEP_TIMEOUT=24h
TREASURY_SETTLEMENT_TIMEOUT=2h
TREASURY_BASE_TX_TIMEOUT=10m

# ---------------------------------------------------------------------------
# FIX 4.4 session (carry initiator, sim-venue acceptor)
# ---------------------------------------------------------------------------
FIX_SENDER=CARRY
FIX_TARGET=SIMV
FIX_HOST=sim-venue
FIX_PORT=5001

# ---------------------------------------------------------------------------
# sim-venue fill model
# ---------------------------------------------------------------------------
SIM_LATENCY_MS=20
SIM_SLIPPAGE_BPS=2
# Orders larger than this fill in slices.
SIM_PARTIAL_THRESHOLD=10

# ---------------------------------------------------------------------------
# PRIVATE — names documented here, values ONLY in .env.private (gitignored).
# Leave blank in this file and in .env. The public stack starts without them;
# Parts 16 and 17 refuse to trade live without them.
# ---------------------------------------------------------------------------
# CB_API_KEY_NAME=
# CB_API_PRIVATE_KEY=
# CB_PORTFOLIO_ID=
# WALLET_ADDRESS=
# SESSION_KEY=
# SESSION_KEY_ROUTER=
# SESSION_KEY_EXPIRY=          # RFC3339; baseVenue refuses to start once past
# SESSION_KEY_ALLOWANCE_USD=
# GAS_POLICY_ID=
